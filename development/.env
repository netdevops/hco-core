# Development values for the compose stack only. Never use them on a shared network.
HCO_DATABASE_URL=postgresql://hco:hco@postgres:5432/hco
HCO_LOG_LEVEL=INFO
HCO_LOG_FORMAT=console
HCO_SOT=yaml
HCO_SOT_PATH=tests/fixtures/inventory.yaml
HCO_CONNECTION=mock
HCO_TRANSCRIPTS_DIR=tests/fixtures/transcripts
HCO_API_URL=http://127.0.0.1:8080
HCO_ACTOR=
# A fixed key for development. The mock connection writes to no device.
HCO_VALIDATION_KEY=development-only-validation-key-0123456789
# Device r1 has the secret key "lab". The mock connection logs in to nothing.
HCO_SECRET_LAB_USERNAME=lab
HCO_SECRET_LAB_PASSWORD=lab
# The host port of the API.
HCO_API_PORT=8080
