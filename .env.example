# Copy this file to .env and change the values. Never commit .env.
HCO_DATABASE_URL=postgresql://hco:hco@localhost:5432/hco
HCO_LOG_LEVEL=INFO
HCO_LOG_FORMAT=json
HCO_SOT=yaml
HCO_SOT_PATH=inventory.yaml
# mock, or scrapli (install hco-core[scrapli]).
HCO_CONNECTION=mock
HCO_TRANSCRIPTS_DIR=transcripts
HCO_API_URL=http://localhost:8080
HCO_ACTOR=
# At least 32 random bytes, for example: python -c "import secrets; print(secrets.token_hex(32))"
HCO_VALIDATION_KEY=
# Used when HCO_SOT=nautobot. Use a read-only Nautobot API token.
HCO_NAUTOBOT_URL=
HCO_NAUTOBOT_TOKEN=
HCO_NAUTOBOT_VERIFY_SSL=true
HCO_NAUTOBOT_TIMEOUT=30
HCO_NAUTOBOT_REDUNDANCY_TAG_PREFIX=hco-redundancy-
# Device credentials for the env secrets provider. <KEY> is the secret key of the device.
# HCO_SECRET_<KEY>_USERNAME=
# HCO_SECRET_<KEY>_PASSWORD=
# Optional enable secret. Without it, the login user needs privilege 15.
# HCO_SECRET_<KEY>_ENABLE=
